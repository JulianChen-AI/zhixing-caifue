[Unit]
Description=Webank competition private test app
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=webank
Group=webank
WorkingDirectory=/srv/webank/current/voice-bank
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=NODE_ENV=production
Environment=NODE_OPTIONS=--max-old-space-size=384
ExecStart=/usr/local/bin/node scripts/preview-local.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/webank
MemoryHigh=500M
MemoryMax=650M

[Install]
WantedBy=multi-user.target
