# Copy to .dev.vars locally; never commit real credentials.
# Enable free-quota-exhaustion stop for BOTH models in the Bailian console.
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_REGION=beijing
QWEN_REALTIME_MODEL=qwen3.8-omni-flash-realtime
QWEN_PLANNER_MODEL=qwen-plus
QWEN_VOICE=Tina
# responses: the realtime model only talks and delegates each business turn to the planner model.
QWEN_DELEGATION=
